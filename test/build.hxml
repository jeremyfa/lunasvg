# JS build of the test runner (run with node from the test/ directory).
# plutovg is expected next to this library (../../plutovg), or installed
# with haxelib (then replace the second -cp line by -lib plutovg).
-cp src
-cp ../src
-cp ../../plutovg/src
# Optional: PNG decoding of data URIs with the format library (test only).
-cp ../../format
# Must come after the format class path to take precedence.
-cp src-overrides
-D lunasvg_png
-main Main
-dce full
-D analyzer-optimize
-js bin/test.js
