package;

import haxe.io.Bytes;
import lunasvg.Bitmap;
import lunasvg.Document;
import lunasvg.FontProvider;
import lunasvg.Lunasvg;
import lunasvg.Matrix;

/**
 * Test runner: unit tests of the public API, then golden comparisons of the
 * case lists (cases-*.txt) against hashes produced by the native lunasvg
 * 3.5.0 library (reference/*.hashes, generated by reference-gen/).
 *
 * Options:
 *   --raw <dir>     native raw dumps (reference-gen --raw), to report the
 *                   maximum channel difference of each case
 *   --lucide <dir>  folder of the Lucide icons (cases-lucide.txt)
 *   --out <dir>     write the Haxe raw dumps to this folder
 *   --only <text>   only run the cases whose name contains <text>
 *   --verbose       print every differing case
 *
 * Exit code is 1 if a unit test fails, a case crashes, or a compared case
 * differs by more than `TOLERANCE` on a channel (or, without raw dumps, has
 * a different hash).
 */
class Main {

    static inline final TOLERANCE = 1;

    static var failures = 0;

    static var rawDir:Null<String> = null;

    static var lucideDir:Null<String> = null;

    static var outDir:Null<String> = null;

    static var only:Null<String> = null;

    static var verbose = false;

    static function log(s:String):Void {
        #if js
        js.Syntax.code("console.log({0})", s);
        #else
        Sys.println(s);
        #end
    }

    static function check(cond:Bool, what:String):Void {
        if (!cond) {
            failures++;
            log('FAIL: $what');
        }
    }

    static function args():Array<String> {
        #if js
        var argv:Array<String> = js.Syntax.code("process.argv.slice(2)");
        return argv;
        #else
        return Sys.args();
        #end
    }

    static function time():Float {
        #if js
        return js.Syntax.code("Date.now()") / 1000.0;
        #else
        return Sys.time();
        #end
    }

    public static function main():Void {
        var a = args();
        var i = 0;
        while (i < a.length) {
            switch a[i] {
                case "--raw":
                    rawDir = a[++i];
                case "--lucide":
                    lucideDir = a[++i];
                case "--out":
                    outDir = a[++i];
                case "--only":
                    only = a[++i];
                case "--verbose":
                    verbose = true;
                default:
            }
            i++;
        }

        if (lucideDir == null) {
            var fallback = "../../../../glaze-golden/gpui-kit/crates/assets/assets/icons";
            if (Fs.exists(fallback))
                lucideDir = fallback;
        }

        #if lunasvg_png
        Lunasvg.imageDecoder = PngDecoder.decode;
        #end

        unitTests();
        runList("cases-resvg.txt");
        runTextWithFontProvider("cases-resvg.txt");
        if (lucideDir != null)
            runList("cases-lucide.txt");
        else
            log("Lucide icons not found (use --lucide <dir>): skipped");

        if (failures > 0) {
            log('$failures failure(s)');
            #if js
            js.Syntax.code("process.exit(1)");
            #else
            Sys.exit(1);
            #end
        } else {
            log("All tests passed");
        }
    }

    // Unit tests of the public API

    static function unitTests():Void {
        check(Lunasvg.version() == 30500 && Lunasvg.versionString() == "3.5.0", "version");
        check(Document.loadFromData("not svg") == null, "invalid document");
        check(Document.loadFromData("<g/>") == null, "root must be svg");

        var svg = '<?xml version="1.0"?>
<!-- comment -->
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="50" viewBox="0 0 200 100">
  <style>.a { fill: #00ff00 } #r2 { fill: blue !important }</style>
  <rect id="r1" class="a" x="0" y="0" width="100" height="100" fill="red"/>
  <rect id="r2" x="100" y="0" width="100" height="100" style="fill: yellow"/>
  <text id="t" x="10" y="50">Hello &amp; bye</text>
</svg>';
        var document = Document.loadFromData(svg);
        check(document != null, "parse document");
        if (document == null)
            return;
        check(document.width() == 100 && document.height() == 50, "intrinsic size");
        var box = document.boundingBox();
        check(box.x == 0 && box.y == 0 && box.w == 100 && box.h == 50, "bounding box " + box);

        var r1 = document.getElementById("r1");
        var r2 = document.getElementById("r2");
        check(!r1.isNull() && !r2.isNull(), "getElementById");
        check(document.getElementById("nope").isNull(), "missing id");
        check(r1.getAttribute("fill") == "#00ff00", "style sheet overrides attribute: " + r1.getAttribute("fill"));
        check(r2.getAttribute("fill") == "blue", "!important overrides inline style: " + r2.getAttribute("fill"));
        check(r1.hasAttribute("x") && !r1.hasAttribute("rx"), "hasAttribute");
        check(document.querySelectorAll("rect").length == 2, "querySelectorAll");
        check(document.querySelectorAll("svg > rect.a").length == 1, "querySelectorAll child class");

        var text = document.getElementById("t");
        var children = text.children();
        check(children.length == 1 && children[0].isTextNode() && children[0].toTextNode().data() == "Hello & bye", "text node");

        var bitmap = document.renderToBitmap();
        check(bitmap.width() == 100 && bitmap.height() == 50, "renderToBitmap size");
        check(pixel(bitmap, 25, 25) == 0xFF00FF00, "rendered green");
        check(pixel(bitmap, 75, 25) == 0xFF0000FF, "rendered blue");

        r1.setAttribute("fill", "#ff0000");
        r2.setAttribute("fill", "currentColor");
        document.documentElement().setAttribute("color", "#123456");
        var bitmap2 = document.renderToBitmap(200, -1);
        check(bitmap2.width() == 200 && bitmap2.height() == 100, "renderToBitmap width only");
        check(pixel(bitmap2, 50, 50) == 0xFFFF0000, "setAttribute fill");
        check(pixel(bitmap2, 150, 50) == 0xFF123456, "currentColor");

        var hit = document.elementFromPoint(75, 25);
        check(hit.equals(r2), "elementFromPoint");
        var local = r2.getBoundingBox();
        check(local.x == 100 && local.w == 100, "element bounding box");

        var custom = Bitmap.create(10, 10);
        custom.clear(0xFFFFFFFF);
        document.render(custom, Matrix.scaled(0.05, 0.05));
        check(pixel(custom, 1, 1) == 0xFFFF0000, "render with matrix");

        var elementBitmap = r2.renderToBitmap();
        check(elementBitmap.width() == 100 && elementBitmap.height() == 100 && pixel(elementBitmap, 50, 50) == 0xFF123456, "element renderToBitmap");

        // Text with a fake font provider: boxes as glyphs.
        Lunasvg.setFontProvider(new BoxFontProvider());
        var textDoc = Document.loadFromData('<svg xmlns="http://www.w3.org/2000/svg" width="100" height="40"><text x="10" y="30" font-size="20" font-family="Test">AB</text></svg>');
        var textBitmap = textDoc.renderToBitmap();
        check(pixel(textBitmap, 15, 25) == 0xFF000000 && pixel(textBitmap, 5, 25) == 0, "text through font provider");
        var tb = textDoc.getElementById("x");
        check(tb.isNull(), "no element");
        Lunasvg.setFontProvider(null);

        // Data URI decoding
        var decoded = Lunasvg.decodeBase64("SGVs bG8=");
        check(decoded != null && decoded.toString() == "Hello", "base64");
    }

    static function pixel(bitmap:Bitmap, x:Int, y:Int):Int {
        return bitmap.surface().getPixel(x, y);
    }

    // Golden comparisons

    static function fnv1a(bytes:Bytes, length:Int):String {
        var hash = 0x811c9dc5;
        for (i in 0...length) {
            hash = hash ^ bytes.get(i);
            hash = imul(hash, 0x01000193);
        }
        return StringTools.hex(hash, 8).toLowerCase();
    }

    static inline function imul(a:Int, b:Int):Int {
        #if js
        return js.Syntax.code("Math.imul({0}, {1})", a, b);
        #else
        // 32-bit wrapping multiply without signed 32-bit overflow (|a * b| < 2^63 here)
        return haxe.Int64.mul(haxe.Int64.ofInt(a), haxe.Int64.ofInt(b)).low;
        #end
    }

    static function flatName(name:String):String {
        return StringTools.replace(name, "/", "__");
    }

    static function readHashes(path:String):Map<String, String> {
        var map = new Map<String, String>();
        if (!Fs.exists(path))
            return map;
        for (line in Fs.readText(path).split("\n")) {
            line = StringTools.trim(line);
            if (line.length == 0)
                continue;
            var parts = line.split(" ");
            map.set(parts[0], parts.slice(1).join(" "));
        }
        return map;
    }

    static function category(name:String):String {
        var parts = name.split("/");
        if (parts.length >= 3)
            return parts[0] + "/" + parts[1];
        return parts[0];
    }

    static function runList(listName:String):Void {
        var hashes = readHashes("reference/" + listName.split(".")[0] + ".hashes");
        var lines = Fs.readText(listName).split("\n");
        var stats = new Map<String, CategoryStats>();
        var order:Array<String> = [];
        var renderTime = 0.0;
        var start = time();
        for (line in lines) {
            line = StringTools.trim(line);
            if (line.length == 0 || line.charAt(0) == "#")
                continue;
            var parts = ~/\s+/g.split(line);
            var name = parts[0];
            var path = parts[1];
            var width = Std.parseInt(parts[2]);
            var height = Std.parseInt(parts[3]);
            var mode = parts[4];
            if (only != null && name.indexOf(only) < 0)
                continue;
            if (StringTools.startsWith(path, "lucide:"))
                path = lucideDir + "/" + path.substr(7);

            var cat = category(name);
            var s = stats.get(cat);
            if (s == null) {
                s = new CategoryStats();
                stats.set(cat, s);
                order.push(cat);
            }

            var result:String;
            var bitmap:Null<Bitmap> = null;
            var t0 = time();
            try {
                var document = Document.loadFromBytes(Fs.readBytes(path));
                if (document == null) {
                    result = "null";
                } else {
                    if (mode == "white")
                        document.documentElement().setAttribute("color", "#ffffff");
                    bitmap = document.renderToBitmap(width, height);
                    if (bitmap.isNull()) {
                        result = "null";
                        bitmap = null;
                    } else {
                        var size = bitmap.stride() * bitmap.height();
                        result = bitmap.width() + " " + bitmap.height() + " " + fnv1a(bitmap.data(), size);
                    }
                }
            } catch (e:Dynamic) {
                failures++;
                s.crashes++;
                log('CRASH: $name: $e');
                continue;
            }
            renderTime += time() - t0;

            if (outDir != null && bitmap != null)
                Fs.writeBytes(outDir + "/" + flatName(name) + ".raw", bitmap.data());

            s.total++;
            if (mode == "nocompare") {
                s.skipped++;
                continue;
            }

            var expected = hashes.get(name);
            if (expected == null) {
                s.missing++;
                continue;
            }

            if (expected == result) {
                s.identical++;
                continue;
            }

            // Different: measure the difference when raw dumps are available.
            var diff = -1;
            if (rawDir != null && bitmap != null && Fs.exists(rawDir + "/" + flatName(name) + ".raw")) {
                var raw = Fs.readBytes(rawDir + "/" + flatName(name) + ".raw");
                if (raw.length == bitmap.stride() * bitmap.height())
                    diff = maxDiff(raw, bitmap.data(), raw.length);
            }

            if (diff >= 0 && diff <= TOLERANCE) {
                s.withinTolerance++;
                if (diff > s.maxDiff)
                    s.maxDiff = diff;
                continue;
            }

            s.different++;
            if (diff > s.maxDiff)
                s.maxDiff = diff;
            failures++;
            if (verbose || s.different <= 3)
                log('DIFF: $name expected [$expected] got [$result]' + (diff >= 0 ? ' max diff $diff' : ''));
        }

        var total = new CategoryStats();
        log('');
        log('$listName');
        log('category                              cases  same  <=1  diff  skip  miss  maxdiff');
        for (cat in order) {
            var s = stats.get(cat);
            log(row(cat, s));
            total.add(s);
        }
        log(row("TOTAL", total));
        log('render time: ${Math.round(renderTime * 1000)} ms (wall ${Math.round((time() - start) * 1000)} ms)');
    }

    /**
     * Renders the text cases again with a font provider (boxes as glyphs),
     * to exercise the text layout code: no comparison, must not crash.
     */
    static function runTextWithFontProvider(listName:String):Void {
        Lunasvg.setFontProvider(new BoxFontProvider());
        var count = 0;
        var start = time();
        for (line in Fs.readText(listName).split("\n")) {
            var parts = ~/\s+/g.split(StringTools.trim(line));
            if (parts.length < 5 || !StringTools.startsWith(parts[0], "text/"))
                continue;
            if (only != null && parts[0].indexOf(only) < 0)
                continue;
            try {
                var document = Document.loadFromBytes(Fs.readBytes(parts[1]));
                if (document != null) {
                    var bitmap = document.renderToBitmap();
                    document.boundingBox();
                }
                count++;
            } catch (e:Dynamic) {
                failures++;
                log('CRASH (text with font provider): ${parts[0]}: $e');
            }
        }
        Lunasvg.setFontProvider(null);
        log('text cases rendered with a font provider: $count (${Math.round((time() - start) * 1000)} ms)');
    }

    static function row(name:String, s:CategoryStats):String {
        inline function pad(v:Dynamic, n:Int):String {
            return StringTools.lpad(Std.string(v), " ", n);
        }
        return StringTools.rpad(name, " ", 36) + pad(s.total, 7) + pad(s.identical, 6) + pad(s.withinTolerance, 5) + pad(s.different, 6)
            + pad(s.skipped, 6) + pad(s.missing, 6) + pad(s.maxDiff, 9) + (s.crashes > 0 ? '  CRASHES ${s.crashes}' : '');
    }

    static function maxDiff(a:Bytes, b:Bytes, length:Int):Int {
        var max = 0;
        for (i in 0...length) {
            var d = a.get(i) - b.get(i);
            if (d < 0)
                d = -d;
            if (d > max)
                max = d;
        }
        return max;
    }

}

class CategoryStats {

    public var total = 0;
    public var identical = 0;
    public var withinTolerance = 0;
    public var different = 0;
    public var skipped = 0;
    public var missing = 0;
    public var crashes = 0;
    public var maxDiff = 0;

    public function new() {}

    public function add(s:CategoryStats):Void {
        total += s.total;
        identical += s.identical;
        withinTolerance += s.withinTolerance;
        different += s.different;
        skipped += s.skipped;
        missing += s.missing;
        crashes += s.crashes;
        if (s.maxDiff > maxDiff)
            maxDiff = s.maxDiff;
    }

}

/**
 * A font provider drawing every glyph as a box, to test the text path.
 */
class BoxFontProvider implements FontProvider {

    public function new() {}

    public function getFontFace(family:String, bold:Bool, italic:Bool):Null<FontFace> {
        return new BoxFontFace();
    }

}

class BoxFontFace implements FontFace {

    public function new() {}

    public function getMetrics(size:Float, metrics:FontMetrics):Void {
        metrics.ascent = size * 0.8;
        metrics.descent = -size * 0.2;
        metrics.lineGap = 0;
    }

    public function getGlyphAdvance(codepoint:Int, size:Float):Float {
        return size * 0.6;
    }

    public function getGlyphExtents(codepoint:Int, size:Float, extents:plutovg.Rect):Void {
        extents.x = 0;
        extents.y = -size * 0.5;
        extents.w = size * 0.5;
        extents.h = size * 0.5;
    }

    public function addGlyphPath(codepoint:Int, size:Float, x:Float, y:Float, path:plutovg.Path):Float {
        path.addRect(x, y - size * 0.7, size * 0.5, size * 0.7);
        return size * 0.6;
    }

}

#if lunasvg_png
/**
 * PNG decoder for `Lunasvg.imageDecoder`, using the format library (test
 * only: lunasvg itself has no image decoder).
 */
class PngDecoder {

    public static function decode(bytes:Bytes):Null<plutovg.Surface> {
        try {
            var data = new format.png.Reader(new haxe.io.BytesInput(bytes)).read();
            var header = format.png.Tools.getHeader(data);
            var bgra = format.png.Tools.extract32(data);
            var rgba = Bytes.alloc(bgra.length);
            var i = 0;
            while (i < bgra.length) {
                rgba.set(i, bgra.get(i + 2));
                rgba.set(i + 1, bgra.get(i + 1));
                rgba.set(i + 2, bgra.get(i));
                rgba.set(i + 3, bgra.get(i + 3));
                i += 4;
            }
            return plutovg.Surface.createFromRgba(rgba, header.width, header.height);
        } catch (e:Dynamic) {
            return null;
        }
    }

}
#end
